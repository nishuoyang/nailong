# 奶龙网站反向代理 + 自动 HTTPS
#
# Caddy 会自动完成：
#   1. 向 Let's Encrypt 申请证书（HTTP-01 挑战，走 80 端口）
#   2. 到期前自动续期（无需 cron / systemd timer）
#   3. http:// -> https:// 跳转
#   4. 设置 X-Forwarded-For / X-Forwarded-Proto 等转发头
#
# 证书与 ACME 账户保存在 /data（对应 compose 里的 caddy_data 卷），
# 该卷必须持久化，否则每次重建容器都会重新签发，容易触发 Let's Encrypt 的速率限制。

# ── 主域名 ──
nailonghub.top {
	# ── 访问日志 ──
	#
	# 加它的原因很具体：2026-09-11 发现生产少了两张图。靠 MinIO 桶目录的 mtime 能把删除
	# 定位到 12:01:14 UTC，但**无法知道是谁删的** —— Caddy 默认不记 access log
	# （整个日志 88 行、零请求行），应用日志又随容器重建丢了。这类问题以后要能几分钟内查清。
	#
	# 四个要点（每条都是踩过的）：
	#   1. 必须删掉 Authorization / Cookie 再落盘。Caddy 默认的 JSON 访问日志**包含请求头**，
	#      不删就等于把 JWT 明文写进磁盘文件。
	#   2. **不能用全局的 log 块来开访问日志**：全局 log 配置的是「默认 logger」，
	#      它只会把运行日志（含启动信息、502 错误）从 stderr 重定向到文件，
	#      `docker logs nailong-caddy` 就再也看不到东西了 —— 而排查 502 正是靠它。
	#      访问日志必须写在**每个 site 块**里。
	#   3. 每个 site 写**各自的文件**。同一个文件挂两个 output 会让两个 writer 各自
	#      按自己的字节数滚动、互相覆盖。
	#   4. 写到 /data/logs（在 caddy_data 卷里）：容器重建后日志仍在，
	#      而且不需要新增卷（新增卷必须重建容器）。
	log {
		output file /data/logs/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# 健康检查每 10 秒一次（外部可用性探针），记下来只会把日志淹掉
	# 注意用的是 `log_skip`：旧名 `skip_log` 在 Caddy 2.11 里已被弃用（会打 WARN）
	@health path /api/health
	log_skip @health

	# ── 发布窗口不再回 502（2026-09-11）──
	#
	# 问题实测：2 秒间隔探针下，**每一次** `docker compose up -d` 都会产生 2~3 次 502
	# （早先「0 次 502」的记录是 10 秒间隔探针的采样假象 —— 对几秒长的窗口，
	#   10 秒采样有一半概率整段漏掉）。
	#
	# 窗口有多长、由什么构成（生产实测）：
	#   应用自身从容器启动到开始监听 = 1.93 秒
	#     （migrate deploy 580ms → seed 202ms → node 加载模块 915ms → 监听 163ms）
	#   但用户可见的空窗 = docker 删旧建新 + 应用启动，且有冷热两种，差 3 倍：
	#     热启动 ≈ 2.55 秒 ／ 冷启动（镜像刚构建完）≈ 8.1 秒
	#   具体数字与两次实测见下面「为什么是 10 秒」。
	#
	# 为什么不是「把停机时间压到 0」：那 1.93 秒的下界就是应用初始化本身
	# （迁移 580ms + 模块加载 915ms 都不是能随手去掉的）。所以真正有效的是让用户
	# **看不见**这段空窗：上游不可达时不要把请求立刻判失败，而是挂住并按间隔重试，
	# 等新容器起来后照常服务 —— 用户侧只是这一次请求慢了几秒（实测 2.07 秒那次
	# 拿到了 200，而同样时刻在不加重试的对照组里是必然的 502）。
	#
	# ⚠️ 加这几行之前先验证过一个前提，因为本项目的上游**永远只有一个**：
	# `lb_try_duration` 的文档措辞是关于「负载均衡选择上游」的，单上游时到底还重不重试，
	# 想当然会白做一轮。实测（docs/verify-caddy-retry.js，20/20 条断言，caddy 2.11）：
	#   - 单上游 + 名字解析失败（NXDOMAIN）→ 请求挂住，上游中途出现后返回 200 ✅
	#   - 单上游 + 连接被拒（容器在但没监听）→ 同上 ✅
	#   - 对照组（同样的时序、不加这几行）→ 仍然 502，且上游**收到 0 个请求** ✅
	#   - 上游始终不出现 → 有上界的 502（配置多少秒就约多少秒后返回），不会无限挂住 ✅
	#   - 已拿到响应的请求一律不重试：500 只送达一次、慢响应只送达一次、
	#     POST 只送达一次且 256KiB 的 body 完整 ✅
	#     （最后一条最关键：若重试能重复执行 POST，点赞/上传配额会被重复记账，
	#       那比 502 更糟。只有 dial 阶段的失败才重试，请求一旦送达就不会再发一次。）
	#
	# ── 为什么是 10 秒（2026-09-11 生产实测后从 5 秒改上来的）──
	#
	# 5 秒是照**热启动**窗口定的，但发布窗口有两种，差 3 倍：
	#   热启动（镜像已在页缓存里）：旧容器停到新容器服务 ≈ **2.55 秒**
	#     → 实测一次请求等了 2.07 秒后拿到 200，正是这套重试按预期生效的证据
	#   冷启动（镜像**刚构建完**，页缓存是冷的）：≈ **8.1 秒**
	#     = docker 删旧建新 3.5 秒 + 应用启动 4.58 秒
	#     （冷启动里 node 加载模块要 4.25 秒，热启动只要 2.14 秒）
	#     实测这次请求在重试窗口里等了 5.16 秒后放弃 —— **差 0.87 秒**就等到了。
	#
	# 10 秒覆盖最坏一次的 8.1 秒并留约 1.9 秒余量；它同时是失败模式的上界：
	# 若新容器起不来（例如迁移失败、崩溃重启循环），请求最多等 10 秒拿到 502，
	# 而不是无限挂住。注意它**只影响 dial 失败的那些请求**，上游正常时零开销。
	# 若将来窗口真的超过 10 秒，正确的做法是查清那几秒花在哪（`docker logs -t` 看
	# entrypoint 与应用的时间线），而不是继续把这里调大。
	reverse_proxy server:3000 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

# ── www 子域 ──
# DNS 里 www 同样指向本机；301 到主域名避免重复内容（Caddy 会为它单独签发证书，
# 否则访问 https://www.nailonghub.top 会报证书错误）
# 纯跳转，不记日志 —— 它只是把流量交回主域名，主域名的日志才是真正有效的记录。
www.nailonghub.top {
	redir https://nailonghub.top{uri} permanent
}

# ── 直接用公网 IP 访问 ──
# 公网 IP 无法签发受信任证书，因此显式声明为 http:// 站点（Caddy 不会尝试 ACME），
# 保持 IP 直连可用（CORS_ORIGINS 里也放行了 http://47.103.38.58）
# 单独一个日志文件：与主域名分开，避免两个 writer 抢同一个文件。
http://47.103.38.58 {
	log {
		output file /data/logs/access-ip.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# 同样用 `log_skip`（非弃用的名字），理由见上面主域名那段
	@health path /api/health
	log_skip @health

	# 与主域名同样加 lb_try_*（IP 直连同样是生产入口，发布窗口一样会 502）
	# 为什么要用「重试」、为什么是 10 秒：见上面主域名那段的完整实测说明。
	reverse_proxy server:3000 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

# 注意：这里**没有**配置 encode / gzip。
# 应用自身已经用 compression 中间件做 gzip（index.html / assets / API 均已实测生效），
# Caddy 不会对已有 Content-Encoding 的响应重复压缩，因此保持单一职责、避免行为歧义。
