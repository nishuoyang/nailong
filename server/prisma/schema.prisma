generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user")
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  bioStatus    String?  @default("approved") @map("bio_status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  images      Image[]
  likes       Like[]
  downloads   Download[]
  comments    Comment[]
  favorites   Favorite[]
  collections Collection[]
  following   Follow[]     @relation("Follower")
  followers   Follow[]     @relation("Following")

  // 后台用户列表：无过滤 + ORDER BY created_at DESC
  @@index([createdAt])
  // Bio 审核列表：WHERE bio_status=? + ORDER BY created_at DESC
  @@index([bioStatus, createdAt])
}

/// 站点开关（关闭注册、限制登录等）。
///
/// 为什么需要这张表：这两个开关原先**只存在 Redis 里**。而 Redis 是缓存不是存储——
/// 生产环境 `appendonly=no`（只有默认的 RDB 快照），且 RedisService.get 在 Redis 不可用时
/// 返回 null，而调用方的判断是「等于 'false'/'true' 才拦截」，也就是 **fail-open**。
/// 两个后果叠加起来是危险的：「关闭注册」「仅管理员可登录」这类应急开关一旦 Redis 被清空
/// 或短暂不可用，就会**静默恢复成开放**，管理员却以为还关着。
/// 设置必须落盘，缓存不能当唯一存储。
///
/// 表里只存「管理员显式改过」的项：默认值写在 SettingsService 里，
/// 这样新增开关不需要迁移，也不会出现「迁移默认值」与「代码默认值」两处不一致。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  /// 最后修改者的用户 id（审计用，可为空：迁移写入的行没有修改人）
  updatedBy String?  @map("updated_by")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  images ImagesOnCategories[]
}

model Image {
  id             String   @id @default(uuid())
  title          String
  description    String?
  url            String
  thumbnailUrl   String?  @map("thumbnail_url")
  thumbnailSmUrl String?  @map("thumbnail_sm_url")
  /// 显示尺寸（像素）。语义是「800px 缩略图（thumbnailUrl）的宽高」：
  /// 上传时由 sharp 读 md 输出缓冲得到；存量数据由 scripts/backfill-image-dims.js 回填。
  /// 宽高比与所展示图片一致（md 只缩宽、不裁剪），供前端 aspect-ratio 占位根治 CLS。
  /// 注意**不是原图尺寸**：原图仅经 /file 代理下载，故意不参与视图加载（避免把
  /// 多 MB 原图拉进视口），所以不需要也没有存储原图宽高。
  width          Int?
  height         Int?
  userId         String   @map("user_id")
  status         String   @default("pending")
  section        String   @default("general")
  isFeatured     Boolean  @default(false) @map("is_featured")
  likeCount      Int      @default(0) @map("like_count")
  downloadCount  Int      @default(0) @map("download_count")
  viewCount      Int      @default(0) @map("view_count")
  /// 评论数 / 收藏数：列表页高频展示，写入时与明细在同一事务里维护，避免 N+1 计数。
  commentCount   Int      @default(0) @map("comment_count")
  favoriteCount  Int      @default(0) @map("favorite_count")
  /// 极小的模糊占位图（data URI）与主色。上传时由 sharp 生成，
  /// 列表先铺主色/模糊图再换清晰图，避免图片加载时的空洞与跳变。
  blurDataUrl    String?  @map("blur_data_url")
  dominantColor  String?  @map("dominant_color")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id])
  categories      ImagesOnCategories[]
  likes           Like[]
  downloads       Download[]
  comments        Comment[]
  favorites       Favorite[]
  tags            ImageTag[]
  collectionItems CollectionItem[]

  // 后台列表 / 精选：WHERE status=? + ORDER BY created_at DESC
  @@index([status, createdAt])
  // 每日上传配额校验：WHERE user_id=? AND created_at>=?；个人「我的作品」列表
  @@index([userId, createdAt])
  // 公开个人主页作品：WHERE user_id=? AND status='approved' + ORDER BY created_at DESC
  @@index([userId, status, createdAt])
  // 发现页：WHERE status='approved' AND section=? + ORDER BY created_at DESC
  @@index([status, section, createdAt])
  // 热门/排行：WHERE status='approved' + ORDER BY like_count DESC
  @@index([status, likeCount])
}

model ImagesOnCategories {
  imageId    String
  categoryId String

  image    Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([imageId, categoryId])
  // 主键是 [imageId, categoryId]，按 categoryId 单列查询（删除分类前统计图片数）用不到前缀
  @@index([categoryId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  imageId   String   @map("image_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
  // 唯一索引以 userId 为前缀，无法服务 image_id 单列查找（删除图片时的级联删除）
  @@index([imageId])
}

model Download {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  imageId   String   @map("image_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // 每日下载配额校验：WHERE user_id=? AND created_at>=?（实测原本是全表 SCAN）
  @@index([userId, createdAt])
  // 删除图片时的级联删除
  @@index([imageId])
}

/// 标签：上传时随图创建，详情页与发现页可筛选。
/// slug 对中文保持原样（URL 编码后仍可读），英文统一小写与连字符。
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  images ImageTag[]

  @@index([createdAt])
}

model ImageTag {
  imageId String @map("image_id")
  tagId   String @map("tag_id")

  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([imageId, tagId])
  @@index([tagId])
}

/// 评论：只允许登录用户发表；作者与管理员可删除。
/// 内容在服务端去标签、压空白、限长，展示层仍按纯文本渲染。
model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String   @map("user_id")
  imageId   String   @map("image_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([imageId, createdAt])
  @@index([userId, createdAt])
}

/// 收藏（喜欢/稍后再看）：与点赞分开，点赞是公开态度，收藏是私人书签。
model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  imageId   String   @map("image_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
  @@index([imageId])
  @@index([userId, createdAt])
}

/// 收藏夹：用户的主题合集，可公开或私密。
/// coverUrl 不落库，读取时取第一张可见图片作为封面，避免删图后留下坏封面。
model Collection {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean  @default(true) @map("is_public")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  imageId      String   @map("image_id")
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  image      Image      @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([collectionId, imageId])
  @@index([imageId])
  @@index([collectionId, createdAt])
}

/// 关注：单向关系。动态页按 followingId 聚合关注对象的作品。
model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}
