generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user")
  avatarUrl    String?  @map("avatar_url")
  bio          String?
  bioStatus    String?  @default("approved") @map("bio_status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  images    Image[]
  likes     Like[]
  downloads Download[]

  // 后台用户列表：无过滤 + ORDER BY created_at DESC
  @@index([createdAt])
  // Bio 审核列表：WHERE bio_status=? + ORDER BY created_at DESC
  @@index([bioStatus, createdAt])
}

/// 站点开关（关闭注册、限制登录等）。
///
/// 为什么需要这张表：这两个开关原先**只存在 Redis 里**。而 Redis 是缓存不是存储——
/// 生产环境 `appendonly=no`（只有默认的 RDB 快照），且 RedisService.get 在 Redis 不可用时
/// 返回 null，而调用方的判断是「等于 'false'/'true' 才拦截」，也就是 **fail-open**。
/// 两个后果叠加起来是危险的：「关闭注册」「仅管理员可登录」这类应急开关一旦 Redis 被清空
/// 或短暂不可用，就会**静默恢复成开放**，管理员却以为还关着。
/// 设置必须落盘，缓存不能当唯一存储。
///
/// 表里只存「管理员显式改过」的项：默认值写在 SettingsService 里，
/// 这样新增开关不需要迁移，也不会出现「迁移默认值」与「代码默认值」两处不一致。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  /// 最后修改者的用户 id（审计用，可为空：迁移写入的行没有修改人）
  updatedBy String?  @map("updated_by")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  images ImagesOnCategories[]
}

model Image {
  id             String   @id @default(uuid())
  title          String
  description    String?
  url            String
  thumbnailUrl   String?  @map("thumbnail_url")
  thumbnailSmUrl String?  @map("thumbnail_sm_url")
  userId         String   @map("user_id")
  status         String   @default("pending")
  section        String   @default("general")
  isFeatured     Boolean  @default(false) @map("is_featured")
  likeCount      Int      @default(0) @map("like_count")
  downloadCount  Int      @default(0) @map("download_count")
  viewCount      Int      @default(0) @map("view_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user       User                  @relation(fields: [userId], references: [id])
  categories ImagesOnCategories[]
  likes      Like[]
  downloads  Download[]

  // 后台列表 / 精选：WHERE status=? + ORDER BY created_at DESC
  @@index([status, createdAt])
  // 每日上传配额校验：WHERE user_id=? AND created_at>=?；个人「我的作品」列表
  @@index([userId, createdAt])
  // 公开个人主页作品：WHERE user_id=? AND status='approved' + ORDER BY created_at DESC
  @@index([userId, status, createdAt])
}

model ImagesOnCategories {
  imageId    String
  categoryId String

  image    Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([imageId, categoryId])
  // 主键是 [imageId, categoryId]，按 categoryId 单列查询（删除分类前统计图片数）用不到前缀
  @@index([categoryId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  imageId   String   @map("image_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
  // 唯一索引以 userId 为前缀，无法服务 image_id 单列查找（删除图片时的级联删除）
  @@index([imageId])
}

model Download {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  imageId   String   @map("image_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  image Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // 每日下载配额校验：WHERE user_id=? AND created_at>=?（实测原本是全表 SCAN）
  @@index([userId, createdAt])
  // 删除图片时的级联删除
  @@index([imageId])
}
