# ===== 生产环境配置 =====
# 复制此文件为 server/.env 并修改

DATABASE_URL=file:/app/data/data.db

# JWT 密钥 — 务必替换为随机字符串！
# 生成命令: openssl rand -hex 32
JWT_SECRET=替换为随机字符串
JWT_REFRESH_SECRET=替换为另一个随机字符串

# Redis（Docker 内部通信，无需修改）
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO（Docker 内部通信）
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nailong-images
