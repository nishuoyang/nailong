# ===== 生产环境配置 =====
# 复制此文件为 server/.env 并修改

DATABASE_URL=file:/app/data/data.db

# JWT 密钥 — 务必替换为随机字符串！
# 生成命令: openssl rand -hex 32
JWT_SECRET=替换为随机字符串
JWT_REFRESH_SECRET=替换为另一个随机字符串

# Redis（Docker 内部通信，无需修改）
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO（Docker 内部通信）
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nailong-images

# 浏览器可访问的图片 URL 前缀 —— 必须是同源代理路径 /minio，不要填域名或 IP。
# 这个值会被拼进 Image.url / thumbnailUrl / thumbnailSmUrl 并**永久存入数据库**：
#  - 填 http://<host>:9000 之类的绝对地址 → 页面上是混合内容（HTTPS 页面里的 HTTP 图片会被浏览器拦掉），
#    且服务端 CSP 是 img-src 'self'，同样会被拦截；
#  - 填 Docker 内网主机名 minio → 浏览器根本无法解析。
# 只对「新上传」生效，改错后已入库的记录需要脚本刷库（server/scripts/fix-image-urls.js）。
MINIO_PUBLIC_URL=/minio
